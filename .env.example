# .env.example - Exemplo de configuração
# INSTRUÇÕES: Copie este arquivo para `.env` e preencha com valores reais.
# NÃO commite o arquivo `.env` no repositório.

# Ambiente (development, production)
ENVIRONMENT=development

# Configurações do Banco de Dados da aplicação
# IMPORTANTE: configurar sempre via ambiente real; não manter defaults antigos em produção.
DB_HOST=seu_host_do_banco
DB_USER=seu_usuario_do_banco
DB_PASS=sua_senha_do_banco
DB_NAME=nome_do_banco

# Banco exclusivo para integração MySQL de testes
# IMPORTANTE: não reutilizar DB_HOST/DB_NAME da aplicação.
# Requer declaração explícita de isolamento para qualquer execução de integração.
TEST_DB_ISOLATED=false
TEST_DB_HOST=seu_host_teste
TEST_DB_PORT=3306
TEST_DB_USER=usuario_teste
TEST_DB_PASS=senha_teste
TEST_DB_NAME=nome_banco_teste_exclusivo

# Configurações de Email/SMTP
# Use App Password do Gmail (não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=SEU_APP_PASSWORD_AQUI
SMTP_SECURE=tls

# Email do Administrador
ADMIN_EMAIL=seu-email@empresa.com

# Configurações de Notificação
NOTIFY_ON_ERROR=true
NOTIFY_ON_SUCCESS=false
INCLUDE_LOGS=true
MAX_LOG_LINES=20

# Configurações de Segurança
SESSION_LIFETIME=86400
COOKIE_SECURE=false   # true em produção
COOKIE_HTTPONLY=true

# URL pública do site
SITE_URL=http://localhost
# URL do aplicativo (usada para Stripe e outras integrações)
APP_URL=https://seu-ngrok-url.ngrok-free.dev
# URL do ngrok (fallback para desenvolvimento)
NGROK_URL=https://seu-ngrok-url.ngrok-free.dev

# Monitoramento e fila de jobs
MONITORING_ENABLED=true
HEALTH_CHECK_SECRET=seu_health_check_secret_aqui
ASYNC_JOB_PROCESSOR_URL=http://localhost/api/v1/utils/process-async-jobs.php
JOB_METRICS_LIMIT=10
JOB_PROCESS_BATCH_SIZE=20
JOB_QUEUE_MAX_PENDING=5000
WEBHOOK_QUEUE_DIR=./queue/webhooks

# Configurações Stripe (preencha com as credenciais da sua conta)
STRIPE_SECRET_KEY=sk_test_SEU_SECRET_KEY_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_SEU_PUBLISHABLE_KEY_AQUI
STRIPE_WEBHOOK_SECRET=whsec_SEU_WEBHOOK_SECRET_AQUI
STRIPE_CURRENCY=brl

# Configurações de Email/SMTP (Gmail)
# IMPORTANTE: Siga os passos abaixo para configurar:
# 1. Acesse: https://myaccount.google.com/apppasswords
# 2. Selecione "Mail" e "Windows Computer" (ou seu SO)
# 3. Copie a senha gerada (16 caracteres sem espaços)
# 4. Cole na variável SMTP_PASS abaixo
# 5. Ative 2FA na conta do Gmail se ainda não tiver ativado
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=SEU_APP_PASSWORD_AQUI
SMTP_SECURE=tls
SMTP_FROM=seu-email@gmail.com
SMTP_FROM_NAME=CRM Imobiliário

# Email do Administrador (não deve ser comitado em repositório público)
ADMIN_EMAIL=seu-email@empresa.com

# Configurações de Notificação
NOTIFY_ON_ERROR=true
NOTIFY_ON_SUCCESS=false
INCLUDE_LOGS=true
MAX_LOG_LINES=20

# Configurações de Segurança
SESSION_LIFETIME=86400
COOKIE_SECURE=false   # Em produção: true
COOKIE_HTTPONLY=true

# Chave opcional para proteger o endpoint de feeds (api/exportProperties.php)
FEED_API_KEY=SEU_FEED_API_KEY_AQUI

# Configurações Google OAuth 2.0 (para integração Gmail)
# Obtenha estas em: https://console.cloud.google.com
# Siga o guia em: google/SETUP_GUIDE.md
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_OAUTH_REDIRECT=http://localhost/google/oauth_callback.php
GOOGLE_LOGIN_OAUTH_REDIRECT=https://seu-ngrok-url.ngrok-free.dev/social/google_callback.php

# Configurações de Login Social com Facebook
FACEBOOK_CLIENT_ID=seu_facebook_app_id_aqui
FACEBOOK_CLIENT_SECRET=seu_facebook_app_secret_aqui
FACEBOOK_OAUTH_REDIRECT=http://localhost/social/facebook_callback.php

# Configurações Web Push Notifications (VAPID Keys)
# Gere novas chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Chave secreta JWT (mínimo 32 bytes)
JWT_SECRET=SEU_JWT_SECRET_AQUI_MINIMO_32_BYTES

