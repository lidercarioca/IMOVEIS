/**
 * MÃ³dulo de Alertas Inteligentes
 * Gerencia visualizaÃ§Ã£o e aÃ§Ãµes de alertas do sistema
 */

let alertsState = {
    currentFilter: 'pending',
    alerts: [],
    stats: {}
};

document.addEventListener('DOMContentLoaded', function() {
    inicializarAlertas();
    // Carregar alertas automaticamente ao inicializar
    setTimeout(() => {
        carregarAlertas();
        carregarStatsAlertas();
    }, 500);
});

/**
 * Inicializa eventos da aba Alertas
 */
function inicializarAlertas() {
    // Carregar alertas ao entrar na aba
    const abaAlertas = document.querySelector('[href="#alertas"]');
    if (abaAlertas) {
        abaAlertas.addEventListener('click', () => {
            carregarAlertas();
            carregarStatsAlertas();
        });


    // Filtro de status
    const statusFilter = document.getElementById('alertas-status-filter');
    if (statusFilter) {
        statusFilter.addEventListener('change', () => {
            carregarAlertas();
        });


    // Filtro de severidade
    const severityFilter = document.getElementById('alertas-severity-filter');
    if (severityFilter) {
        severityFilter.addEventListener('change', () => {
            carregarAlertas();
        });


    // BotÃ£o limpar filtros
    const btnLimpar = document.getElementById('btn-limpar-filtros');
    if (btnLimpar) {
        btnLimpar.addEventListener('click', () => {
            if (statusFilter) statusFilter.value = 'todos';
            if (severityFilter) severityFilter.value = 'todos';
            
            // Feedback visual
            const iconOriginal = btnLimpar.innerHTML;
            btnLimpar.disabled = true;
            btnLimpar.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Limpando...';
            
            carregarAlertas().finally(() => {
                btnLimpar.disabled = false;
                btnLimpar.innerHTML = iconOriginal;
            });
        });
    }

    // BotÃ£o recarregar
    const btnRecarregar = document.getElementById('btn-recarregar-alertas');
    if (btnRecarregar) {
        btnRecarregar.addEventListener('click', () => {
            // Adicionar feedback visual
            const iconOriginal = btnRecarregar.innerHTML;
            btnRecarregar.disabled = true;
            btnRecarregar.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Carregando...';
            
            // Executar carregamento
            Promise.all([carregarAlertas(), carregarStatsAlertas()]).finally(() => {
                // Restaurar botÃ£o apÃ³s carregamento
                btnRecarregar.disabled = false;
                btnRecarregar.innerHTML = iconOriginal;
            });
        });

    // Carregar automaticamente a cada 5 minutos
    setInterval(carregarAlertas, 5 * 60 * 1000);
}

/**
 * Carrega estatÃ­sticas de alertas
 */
async function carregarStatsAlertas() {
    try {
        const res = await fetch('/api/v1/alertas/getStats.php', {
            credentials: 'include'
        });

        // Tratamento de erros HTTP
        if (res.status === 401) {
            return;
        }
        if (!res.ok) {
            return;
        }

        const result = await res.json();

        if (result.success && result.data) {
            const stats = result.data;
            
            // Atualizar cards
            const totalElement = document.getElementById('alertas-total');
            if (totalElement) {
                totalElement.textContent = stats.total || 0;
            }
            
            const pendenteElement = document.getElementById('alertas-pendentes');
            if (pendenteElement) {
                pendenteElement.textContent = stats.pending || 0;
            }
            
            const criticoElement = document.getElementById('alertas-criticos');
            if (criticoElement) {
                criticoElement.textContent = stats.inactive_leads || 0;
            }

            const resolvidoElement = document.getElementById('alertas-resolvidos');
            if (resolvidoElement) {
                resolvidoElement.textContent = stats.acknowledged || 0;
            }
        }
    } catch (e) {
    }
}

/**
 * Carrega lista de alertas com filtros
 */
async function carregarAlertas() {
    try {
        const statusValue = document.getElementById('alertas-status-filter')?.value || 'todos';
        const severityValue = document.getElementById('alertas-severity-filter')?.value || 'todos';

        let url = `/api/v1/alertas/getAlerts.php?page=1&limit=50`;

        // Sempre enviar o status (mesmo que seja 'todos')
        url += `&status=${encodeURIComponent(statusValue)}`;

        // Sempre enviar a severidade (mesmo que seja 'todos')
        if (severityValue && severityValue !== 'todos') {
            url += `&severity=${encodeURIComponent(severityValue)}`;
        }

        const res = await fetch(url, {
            credentials: 'include'
        });


        // Tratamento de erros HTTP
        if (res.status === 401) {
            mostrarAvisoErroAlerta('SessÃ£o expirada. FaÃ§a login novamente.', 'error');
            window.location.href = '/login.php';
            return;
        }
        if (res.status === 403) {
            mostrarAvisoErroAlerta('VocÃª nÃ£o tem permissÃ£o para acessar este recurso.', 'error');
            return;
        }
        if (!res.ok) {
            mostrarAvisoErroAlerta(`Erro na requisiÃ§Ã£o: ${res.status} ${res.statusText}`, 'error');
            return;
        }

        const result = await res.json();

        if (result.success) {
            alertsState.alerts = result.data;
            renderizarAlertas(result.data);
        } else {
            mostrarAvisoErroAlerta(result.error || 'Erro ao carregar alertas', 'warning');
        }
    } catch (e) {
        mostrarAvisoErroAlerta('Erro ao carregar alertas: ' + e.message, 'error');
    }
}

/**
 * Renderiza tabela de alertas
 */
function renderizarAlertas(alertas) {
    const tbody = document.getElementById('alertas-tbody');
    if (!tbody) {
        return;
    }

    if (!alertas || alertas.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">Nenhum alerta encontrado</td></tr>`;
        return;
    }

    tbody.innerHTML = alertas.map(alert => {
        let tipoDisplay = '';
        let relacionado = '';
        
        try {
            if (alert.data && typeof alert.data === 'string') {
                alert.data = JSON.parse(alert.data);
            }
        } catch (e) {
            // data nÃ£o Ã© JSON vÃ¡lido
        }

        if (alert.alert_type === 'inactive_lead') {
            tipoDisplay = 'â³ Lead Inativo';
            relacionado = alert.data?.lead_name ? `<span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">Lead: ${alert.data.lead_name}</span>` : '';
        } else if (alert.alert_type === 'inactive_property') {
            tipoDisplay = 'ðŸ  ImÃ³vel Inativo';
            relacionado = alert.data?.property_title ? `<span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">ImÃ³vel: ${alert.data.property_title}</span>` : '';
        } else {
            tipoDisplay = alert.alert_type;
        }

        const status = alert.status || 'pending';
        const severity = alert.severity || 'MÃ©dia';
        
        // Mapear status para display e classes CSS
        const statusMap = {
            'pending': { label: 'â³ Pendente', class: 'bg-yellow-100 text-yellow-800' },
            'acknowledged': { label: 'âœ… Reconhecido', class: 'bg-blue-100 text-blue-800' }
        };
        
        const statusDisplay = statusMap[status] || statusMap['pending'];
        const statusClass = statusDisplay.class;

        // Mapear severidade para display com Ã­cone e cor
        const severityMap = {
            'Baixa': { icon: 'ðŸŸ¢', label: 'Baixa', class: 'bg-green-100 text-green-800' },
            'MÃ©dia': { icon: 'ðŸŸ¡', label: 'MÃ©dia', class: 'bg-yellow-100 text-yellow-800' },
            'Alta': { icon: 'ðŸ”´', label: 'Alta', class: 'bg-orange-100 text-orange-800' },
            'CrÃ­tica': { icon: 'âš ï¸', label: 'CrÃ­tica', class: 'bg-red-100 text-red-800' }
        };
        
        const severityDisplay = severityMap[severity] || severityMap['MÃ©dia'];

        return `
            <tr class="border-b hover:bg-gray-50">
                <td class="px-6 py-4 text-center">
                    <span class="px-2 py-1 rounded-full text-xs font-semibold ${severityDisplay.class}">
                        ${severityDisplay.icon} ${severityDisplay.label}
                    </span>
                </td>
                <td class="px-6 py-4">
                    <div class="font-medium text-sm">${alert.title}</div>
                    <div class="text-xs text-gray-500 mt-1">${alert.message}</div>
                </td>
                <td class="px-6 py-4 text-sm">
                    ${relacionado}
                </td>
                <td class="px-6 py-4 text-center">
                    <span class="px-2 py-1 rounded-full text-xs font-semibold ${statusClass}">
                        ${statusDisplay.label}
                    </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">
                    ${new Date(alert.sent_at).toLocaleDateString('pt-BR')}
                </td>
                <td class="px-6 py-4 text-right">
                    <div class="flex gap-2 justify-end">
                        ${status === 'pending' ? `<button onclick="reconhecerAlerta(${alert.id})" class="px-2 py-1 bg-blue-500 text-white rounded text-xs hover:bg-blue-600 transition">Reconhecer</button>` : ''}
                        ${status !== 'acknowledged' ? `<button onclick="descartarAlerta(${alert.id})" class="px-2 py-1 bg-red-500 text-white rounded text-xs hover:bg-red-600 transition">Descartar</button>` : ''}
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

/**
 * Reconhecer um alerta (marcar como lido)
 */
async function reconhecerAlerta(alertId) {
    if (!confirm('Deseja marcar este alerta como lido?')) return;

    try {
        const res = await fetch('/api/v1/alertas/acknowledgeAlert.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ alert_id: alertId })
        });

        const result = await res.json();
        if (result.success) {
            carregarAlertas();
            carregarStatsAlertas();
        } else {
            alert('Erro: ' + result.error);
        }
    } catch (e) {
        alert('Erro ao processar alerta');
    }
}

/**
 * Descartar um alerta (remover)
 */
async function descartarAlerta(alertId) {
    if (!confirm('Deseja descartar este alerta?')) return;

    try {
        const res = await fetch('/api/v1/alertas/dismissAlert.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ alert_id: alertId, reason: 'Manual dismiss' })
        });

        const result = await res.json();
        if (result.success) {
            carregarAlertas();
            carregarStatsAlertas();
        } else {
            alert('Erro: ' + result.error);
        }
    } catch (e) {
        alert('Erro ao processar alerta');
    }
}

/**
 * Classe CSS para badge de severidade
 */
function getSeverityBadgeClass(severity) {
    const map = {
        'Baixa': 'bg-green-100 text-green-800',
        'low': 'bg-green-100 text-green-800',
        'MÃ©dia': 'bg-yellow-100 text-yellow-800',
        'medium': 'bg-yellow-100 text-yellow-800',
        'Alta': 'bg-red-100 text-red-800',
        'high': 'bg-red-100 text-red-800',
        'CrÃ­tica': 'bg-red-900 text-white',
        'critical': 'bg-red-900 text-white'
    };
    return map[severity] || 'bg-gray-100 text-gray-800';
}

/**
 * Classe CSS para badge de status
 */
function getStatusBadgeClass(status) {
    const map = {
        'pending': 'bg-yellow-100 text-yellow-800',
        'acknowledged': 'bg-blue-100 text-blue-800'
    };
    return map[status] || 'bg-gray-100 text-gray-800';
}

/**
 * Mostrar aviso/erro visual para o usuÃ¡rio (Alertas)
 */
function mostrarAvisoErroAlerta(mensagem, tipo = 'warning') {
    const alertClass = tipo === 'error' ? 'alert-danger' : 'alert-warning';
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
    alertDiv.style.zIndex = '9999';
    alertDiv.innerHTML = `
        <i class="fas ${tipo === 'error' ? 'fa-exclamation-circle' : 'fa-exclamation-triangle'} me-2"></i>
        ${mensagem}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alertDiv);

    // Auto-remover apÃ³s 5 segundos
    setTimeout(() => {
        alertDiv.remove();
    }, 5000);
}
