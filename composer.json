{
    "name": "imoveis-system/google-integration",
    "description": "Google Gmail API integration for property management system",
    "require": {
        "php": ">=7.4",
        "google/apiclient": "2.18",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "minishlink/web-push": "^8.0",
        "lcobucci/jwt": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Services\\": "app/services/",
            "App\\Utils\\": "app/utils/"
        },
        "files": [
            "app/helpers/property_helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
